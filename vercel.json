{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/api/contact",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    {
      "source": "/",
      "destination": "/api/markdown",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/api/markdown",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ]
    },
    { "source": "/blogs", "destination": "/api/blogs-list-render" },
    { "source": "/blogs/:slug", "destination": "/api/blog-render" },
    { "source": "/projects", "destination": "/api/projects-list-render" },
    { "source": "/project/:slug", "destination": "/api/project-render" },
    { "source": "/(about|about-us|services|contact|contact-us)", "destination": "/" },
    { "source": "/(project-category|project-tag|category|tag)/:slug", "destination": "/" },
    { "source": "/(.*)", "destination": "/api/page-render" }
  ],
  "functions": {
    "api/blog-render.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/blogs-list-render.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/project-render.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/projects-list-render.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/page-render.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
