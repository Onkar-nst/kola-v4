import { useState } from "react";
import RevealText from "@/shared/effects/RevealText";

// Home 3 Section 7 — Who we are
//
// The four values were labels and nothing else, which asked the reader to
// take "Results Driven" on trust. Each now opens onto the sentence that
// says what it means, verbatim from kola-content.md "Built on Unshakeable
// Values" — the same copy kolacommunications.com prints on its own cards.
//
// Disclosures rather than four open cards: the column beside the photograph
// has room for four labels, not for four paragraphs, and the plus icon the
// section already carried was promising this behaviour anyway. Any number can
// be open at once — reading one is not a reason to close another.

const ARROW_SVG = (
    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
            d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z"
            fill="currentColor"
        />
    </svg>
);

const BULLET_ICON = (
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path
            d="M9 0C13.9706 0 18 4.02944 18 9C18 13.9706 13.9706 18 9 18C4.02944 18 0 13.9706 0 9C0 4.02944 4.02944 0 9 0ZM8 5V8H5V10H8V13H10V10H13V8H10V5H8Z"
            fill="currentColor"
        />
    </svg>
);

const VALUES = [
    {
        title: "Results Driven",
        text: "We focus on delivering measurable outcomes that directly impact your business growth and success.",
    },
    {
        title: "Innovation First",
        text: "We stay ahead of digital trends and leverage cutting edge technologies to give you a competitive edge.",
    },
    {
        title: "Client Centric",
        text: "Your success is our priority. We build lasting partnerships through transparent communication and dedicated support.",
    },
    {
        title: "Quality Excellence",
        text: "We maintain the highest standards in every project, ensuring exceptional quality and attention to detail.",
    },
];

export default function Section7() {
    const [open, setOpen] = useState<string[]>([]);

    const toggle = (title: string) =>
        setOpen((current) =>
            current.includes(title) ? current.filter((t) => t !== title) : [...current, title],
        );

    return (
        <section className="home-3-section-7 pt-120 pb-120 p-relative">
            {/* Background grid */}
            <div className="position-absolute w-100 h-100 d-grid top-0 md:grid-cols-7 gap-0 z-n1 opacity-10">
                {[0, 1, 2, 3, 4, 5, 6].map((i) => (
                    <div
                        key={i}
                        className={
                            i === 3
                                ? "position-relative h-100 border-r border-dark/01 md:border-none"
                                : "position-relative h-100 overflow-hidden d-md-block border-dark/01"
                        }
                    >
                        <div className="absolute bottom-0 left-0 right-0 border-white/10" />
                        {i === 3 && (
                            <div className="absolute top-[20%] left-0 right-0 h-[30%] bg-gradient-to-b from-white/5 to-transparent pointer-events-none" />
                        )}
                    </div>
                ))}
            </div>

            <div className="container">
                <div className="row g-4 align-items-center align-items-lg-start">
                    <div className="col-lg-6">
                        <img
                            src="/assets/imgs/kola/about.jpg"
                            alt="Kola Communications"
                            width={800}
                            height={600}
                            className="img-cover" loading="lazy" />
                    </div>
                    <div className="col-lg-5 mx-auto">
                        <span className="at-btn common-black text-uppercase bg-transparent mb-10 rounded-0 p-0">
                            <span className="text-uppercase">
                                <span className="text-1">WHO WE ARE</span>
                                <span className="text-2">WHO WE ARE</span>
                            </span>
                            <i>
                                {ARROW_SVG}
                                {ARROW_SVG}
                            </i>
                        </span>
                        <h4 className="reveal-text mb-0 pe-lg-5">
                            <RevealText>
                                Helping brands grow in a digital first world, trusted by clients across India,
                                Australia, the US, Europe, and the Middle East.
                            </RevealText>
                        </h4>

                        {/* One column rather than the two this used to be: a
                            240px half-column turned a two-line sentence into
                            five. */}
                        <ul className="kola-values">
                            {VALUES.map((value) => {
                                const expanded = open.includes(value.title);
                                const id = `kola-value-${value.title.toLowerCase().replace(/[^a-z]+/g, "-")}`;
                                return (
                                    <li
                                        className={`kola-value${expanded ? " is-open" : ""}`}
                                        key={value.title}
                                    >
                                        <button
                                            type="button"
                                            className="kola-value__head"
                                            aria-expanded={expanded}
                                            aria-controls={id}
                                            onClick={() => toggle(value.title)}
                                        >
                                            <span className="kola-value__icon" aria-hidden="true">
                                                {BULLET_ICON}
                                            </span>
                                            <span className="kola-value__title fz-font-md">
                                                {value.title}
                                            </span>
                                        </button>

                                        {/* 0fr -> 1fr rather than a max-height guess, so
                                            each value opens to its own real height. */}
                                        <div className="kola-value__panel" id={id}>
                                            <div className="kola-value__panel-inner">
                                                <p className="kola-value__text">{value.text}</p>
                                            </div>
                                        </div>
                                    </li>
                                );
                            })}
                        </ul>

                        {/* No portrait. The avatar here was template stock standing in
                            for a real, named client — inventing a face for someone who
                            has none published is worse than showing none, and it is the
                            same call Section 13 makes with its initial-letter marks. */}
                        <div className="testimonial-author d-flex align-items-start mb-0">
                            <div className="testimonial-content">
                                <p className="fz-xl neutral-900 fw-400">
                                    &ldquo;Working with an agency halfway across the world felt like a risk, but Kola
                                    Communications made it seamless. Our Google rankings improved within weeks and the
                                    leads started coming in consistently.&rdquo;
                                </p>
                                <h6 className="testimonial-content-author-name fw-600 mb-0 fz-font-md">
                                    James Whitfield
                                </h6>
                                <p className="testimonial-content-author-position m-0 fz-font-label">
                                    CEO, BrightPath (UK)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    );
}
